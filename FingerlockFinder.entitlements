<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. This one deliberately asks for nothing
	     else: it never opens a file, it only reads the selected paths from Finder
	     and passes them to the main app. No keychain, no Enclave, no file access. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
